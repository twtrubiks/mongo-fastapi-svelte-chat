# 複製此檔案為 .env 並根據需要調整設定

# JWT 設定（必填，啟動時無預設值會報錯）
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# 以下為安全相關設定（皆有預設值，可視需要覆蓋）

# HSTS 設定
SECURITY_ENABLE_HSTS=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=true

# CSP 設定
SECURITY_ENABLE_CSP=true
SECURITY_CSP_REPORT_ONLY=false
# 後端未內建 CSP 報告接收端點，有自己的收集服務時再設定
# SECURITY_CSP_REPORT_URI=https://csp-report.example.com/report

# 其他安全設定
SECURITY_ENABLE_HEADERS=true
SECURITY_HIDE_SERVER=true
SECURITY_SERVER_HEADER=FastAPI

# 開發模式 (會使用較寬鬆的 CSP)；app 啟動時會改以 DEBUG 的值為準
SECURITY_DEVELOPMENT_MODE=false
# 應用程式設定
# DEBUG 預設為 false（安全預設）；開發環境設 true 以啟用詳細錯誤與 API docs
DEBUG=true

# MongoDB 連線（預設值不帶憑證；含帳密的連線字串務必放在 .env，不要寫進程式碼）
MONGODB_URL=mongodb://root:password@localhost:27017

# Redis 連線
REDIS_URL=redis://localhost:6379/0

# Rate Limiting — 可信反向代理 IP（逗號分隔）
# 只有來自這些 IP 的請求，其 X-Forwarded-For 才會被 rate limiter 採信（防偽造換桶）
# 預設信任本機（SvelteKit BFF 與後端同機）；BFF 或反向代理分機部署時必須改成其實際 IP
# TRUSTED_PROXIES=127.0.0.1,::1

# AI 助理（@bot / summary）— 選用，未設定對應 key 時 @bot 回「尚未配置」而不打 API
# 供應商切換：nvidia（NIM，OpenAI 相容端點）| gemini（Google 原生 SDK）
AI_PROVIDER=nvidia
# NVIDIA NIM key（取得：https://build.nvidia.com/）
NVIDIA_API_KEY=
# Gemini key（AI_PROVIDER=gemini 時生效，取得：https://aistudio.google.com/）
GOOGLE_API_KEY=
